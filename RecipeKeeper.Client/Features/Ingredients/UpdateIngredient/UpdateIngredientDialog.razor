<MudDialog>
    <DialogContent>
        <EditForm Model="@_updateRequest">
            <DataAnnotationsValidator/>
            <MudStack Spacing="3">
                <MudNumericField
                    Label="Position"
                    @bind-Value="_updateRequest.Position"
                    For="@(() => _updateRequest.Position)"/>
                <MudTextField
                    Label="Description"
                    @bind-Value="_updateRequest.Description"
                    For="@(() => _updateRequest.Description)"/>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    [EditorRequired]
    public required IngredientResponse Ingredient { get; set; }

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    protected override void OnInitialized()
    {
        _updateRequest = new UpdateIngredientRequest
        {
            Position = Ingredient.Position,
            Description = Ingredient.Description,
        };
    }

    private UpdateIngredientRequest _updateRequest = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_updateRequest));
    private void Cancel() => MudDialog.Cancel();
}