<MudDialog>
    <DialogContent>
        <EditForm Model="@_createRequest">
            <DataAnnotationsValidator/>
            <MudStack Spacing="3">
                <MudNumericField
                    Label="Position"
                    @bind-Value="_createRequest.Position"
                    For="@(() => _createRequest.Position)"/>
                <MudTextField
                    Label="Description"
                    @bind-Value="_createRequest.Description"
                    For="@(() => _createRequest.Description)"/>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Submit</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }
    private readonly CreateIngredientRequest _createRequest = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_createRequest));
    private void Cancel() => MudDialog.Cancel();
}