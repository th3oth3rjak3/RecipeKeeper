<EditForm Model="@_createRequest" OnValidSubmit="Submit">
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator/>
            <MudStack Spacing="3">
                <MudNumericField
                    Label="Position"
                    @bind-Value="_createRequest.Position"
                    For="@(() => _createRequest.Position)"/>
                <MudTextField
                    Label="Description"
                    @bind-Value="_createRequest.Description"
                    For="@(() => _createRequest.Description)"/>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Submit</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    [EditorRequired]
    public required int NextPosition { get; set; }

    protected override void OnInitialized()
    {
        _createRequest.Position = NextPosition;
    }

    private readonly CreateInstructionRequest _createRequest = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_createRequest));
    private void Cancel() => MudDialog.Cancel();
}