<EditForm Model="@_updateRequest" OnValidSubmit="Submit">
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator/>
            <MudStack Spacing="3">
                <MudNumericField
                    Label="Position"
                    @bind-Value="_updateRequest.Position"
                    For="@(() => _updateRequest.Position)"/>
                <MudTextField
                    Label="Description"
                    @bind-Value="_updateRequest.Description"
                    For="@(() => _updateRequest.Description)"/>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit">Submit</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [Parameter]
    [EditorRequired]
    public required InstructionResponse Instruction { get; set; }

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    protected override void OnInitialized()
    {
        _updateRequest = new UpdateInstructionRequest
        {
            Position = Instruction.Position,
            Description = Instruction.Description,
        };
    }

    private UpdateInstructionRequest _updateRequest = new();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_updateRequest));
    private void Cancel() => MudDialog.Cancel();
}